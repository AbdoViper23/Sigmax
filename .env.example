# ---- Story / CDR (Layer 1) ----
STORY_RPC_URL=https://aeneid.storyrpc.io
# Funded Aeneid testnet wallet (gets IP from https://aeneid.faucet.story.foundation). Publishes signals + owns the operator license.
CDR_KEY=0x
# Strategy IP Asset id (ERC-6551 address) created on Story; and the operator license token minted to the agent.
STRATEGY_IP_ID=0x
OPERATOR_LICENSE_TOKEN_ID=

# ---- Liquidity chain (Layer 3) ----
# Used for `anvil --fork-url`. Public fallback works but a dedicated RPC is more reliable.
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# Agent executor key (bounded executeSwap only — never holds funds).
AGENT_PK=0x
# Optional: 0x Swap API v2 key. If absent, PoC #2 falls back to a direct Uniswap v3 router call.
ZEROX_API_KEY=
