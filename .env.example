# ---- Story / CDR (Layer 1) ----
STORY_RPC_URL=https://aeneid.storyrpc.io
# Story-API REST base for CDR DKG partials (CDR-live only). Aeneid default below — may change between deployments.
STORY_API_URL=http://172.192.41.96:1317
# Funded Aeneid testnet wallet (gets IP from https://aeneid.faucet.story.foundation). Publishes signals + owns the operator license.
CDR_KEY=0x
# Strategy IP Asset id (ERC-6551 address) created on Story; and the operator license token minted to the agent.
STRATEGY_IP_ID=0x
OPERATOR_LICENSE_TOKEN_ID=

# ---- Story IP / PIL / license / royalty (packages/story poc-story) ----
# Funded Aeneid wallet acting as the leader: registers the strategy IP, attaches PIL terms, mints licenses.
# Needs both native IP (gas) and wrapped $WIP (license minting fee). Often the same key as CDR_KEY.
STORY_IP_KEY=0x
# Address the operator License Token is minted to (the agent). poc-story prints the resulting OPERATOR_LICENSE_TOKEN_ID.
AGENT_ADDRESS=0x
# Optional overrides: SPG collection, $WIP token, monthly price (in $WIP), platform revenue share (bps), a follower to demo the 85/15 split.
# SPG_NFT_CONTRACT=0xc32A8a0FF3beDDDa58393d022aF433e78739FAbc
# WIP_ADDRESS=
# MONTHLY_PRICE_WIP=1
# REV_SHARE_BPS=1500
# FOLLOWER_ADDRESS=0x

# ---- SubscriptionRegistry (Story L1 deploy) ----
# Treasury that receives the platform fee portion of every subscription payment.
PLATFORM_TREASURY=0x

# ---- Liquidity chain (Layer 3) ----
# Used for `anvil --fork-url`. Public fallback works but a dedicated RPC is more reliable.
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# Agent executor key (bounded executeSwap only — never holds funds).
AGENT_PK=0x
# Optional: 0x Swap API v2 key. If absent, PoC #2 falls back to a direct Uniswap v3 router call.
ZEROX_API_KEY=
