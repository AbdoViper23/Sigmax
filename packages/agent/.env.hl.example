# ─────────────────────────────────────────────────────────────────────────────
# Run the agent on Hyperliquid testnet with REAL CDR (confidential signals on Story Aeneid).
# Copy to .env (or export) and run:  pnpm --filter @sigmax/agent start
# Full sequence is documented at the bottom.
# ─────────────────────────────────────────────────────────────────────────────

# --- Venue ---
EXECUTION_VENUE=hyperliquid
HYPERLIQUID_TESTNET=true

# --- Keys ---
# AGENT_PK: required by config (executor key). HYPERLIQUID_AGENT_PK: the HL agent key from
# `scripts/hl-gen-agent.ts` that the follower approved via `scripts/hl-approve.ts`.
AGENT_PK=0xYOUR_AGENT_KEY
HYPERLIQUID_AGENT_PK=0xYOUR_HL_AGENT_KEY

# --- Confidential signal path (CDR on Story Aeneid) — REQUIRED ---
# CDR_KEY: the wallet that holds the operator license(s) leaders mint to the agent (the same address
#   the web mints to, i.e. VITE_AGENT_ADDRESS) and that signs CDR allocate/write/read txs. Fund it
#   with Aeneid IP from https://aeneid.faucet.story.foundation
# STORY_API_URL: Story-API REST base for CDR DKG partials (may change between deployments).
CDR_KEY=0xYOUR_CDR_WALLET_KEY
STORY_API_URL=http://172.192.41.96:1317
# Optional seeds for license discovery (the agent also scans its wallet's LicenseToken transfers on boot):
# OPERATOR_LICENSE_TOKEN_ID=...
# STRATEGY_IP_ID=0x...

# --- Hyperliquid spot config ---
# HYPERLIQUID_TOKENS is OPTIONAL: signals carry the spot coin symbol directly (e.g. "HYPE") and the
# agent resolves any coin live from spotMeta. Keep it only as a legacy address→symbol override.
# Per-trade cap in 1e8 USD units (e.g. $15 = 1500000000).
HYPERLIQUID_PER_TRADE_CAP=1500000000

# --- Subscription gate (Story) ---
STORY_RPC_URL=https://aeneid.storyrpc.io
REGISTRY_ADDRESS=0xYOUR_DEPLOYED_SUBSCRIPTION_REGISTRY
# Your HL wallet (the follower) — also the address that approved the agent + deposited USDC.
FOLLOWERS=0xYOUR_FOLLOWER_WALLET
# TRUE  = demo bypass: treat FOLLOWERS as active without an on-chain subscription (fastest).
# FALSE = require a real Story subscription (run scripts/sub-create-plan + scripts/sub-subscribe first).
TRUST_CONFIGURED_FOLLOWERS=false

# --- Misc ---
POLL_MS=10000               # TP/SL price poll interval
DEFAULT_SLIPPAGE_BPS=100    # 1% — used for market orders and TP/SL exits
HTTP_PORT=8787

# ─────────────────────────────────────────────────────────────────────────────
# RUN SEQUENCE (no frontend)
#   1. pnpm --filter @sigmax/agent exec tsx scripts/hl-gen-agent.ts        # → HL_AGENT_ADDRESS + HYPERLIQUID_AGENT_PK
#   2. MASTER_PK=0x<your wallet> HL_AGENT_ADDRESS=0x… HYPERLIQUID_TESTNET=true \
#        pnpm --filter @sigmax/agent exec tsx scripts/hl-approve.ts        # follower approves the agent
#   3. (real subscription) STRATEGY_IP_ID=0x… REGISTRY_ADDRESS=0x… LEADER_PK=0x… \
#        pnpm --filter @sigmax/agent exec tsx scripts/sub-create-plan.ts   # leader creates a plan (once)
#      STRATEGY_IP_ID=0x… REGISTRY_ADDRESS=0x… FOLLOWER_PK=0x… \
#        pnpm --filter @sigmax/agent exec tsx scripts/sub-subscribe.ts     # follower subscribes
#      (or set TRUST_CONFIGURED_FOLLOWERS=true to skip 3)
#   4. pnpm --filter @sigmax/agent start                                   # run the agent daemon
#   5. STRATEGY_IP_ID=0x… HL_TOKEN=HYPE HL_QUOTE=USDC HL_MAX_ENTRY=0 \
#        pnpm --filter @sigmax/agent exec tsx scripts/hl-publish.ts        # MARKET signal → encrypts on Story, fills on HL
#      …HL_MAX_ENTRY=70 …                                                  # LIMIT signal → fills if marketable, else skip
# ─────────────────────────────────────────────────────────────────────────────
