# Sigmax web app (Vite). All vars are build-time `VITE_*`. When the per-deployment addresses below
# are all set AND a wallet is connected, the leader/follower/strategy pages use real contracts;
# otherwise the UI falls back to mock data so it always renders.

# ---- Per-deployment addresses (gate `chainConfigReady`) ----
# SubscriptionRegistry on Story L1 (createPlan / subscribe / plans).
VITE_REGISTRY_ADDRESS=
# CopyVaultFactory on the liquidity chain (vaultOf / createVault).
VITE_FACTORY_ADDRESS=
# The strategy's Story IP Asset id (ERC-6551 address) — the single configured strategy.
VITE_STRATEGY_IP_ID=
# Agent executor address (granted the scoped executor role on each vault).
VITE_AGENT_ADDRESS=

# ---- Agent publish endpoint (leader "Publish Signal") ----
# Base URL of the agent's HTTP server (see HTTP_PORT in the root .env). When unset, publishing
# stays mock (the page works without the daemon). CDR encryption is server-only.
VITE_AGENT_API_URL=http://localhost:8787

# ---- Optional overrides ----
# Routers to whitelist on the vault at creation (comma-separated); the agent's swap router(s).
VITE_ROUTERS=
# Platform fee in bps passed to createPlan (default 1500 = 15%).
VITE_PLATFORM_FEE_BPS=1500
# RPC overrides (default to @sigmax/shared chain defaults).
# VITE_STORY_RPC_URL=
# VITE_LIQUIDITY_RPC_URL=
# Token overrides (default to @sigmax/shared addresses).
# VITE_WIP_ADDRESS=
# VITE_USDC_ADDRESS=
# VITE_WETH_ADDRESS=
# WalletConnect project id (placeholder is fine for injected wallets in the demo).
# VITE_WALLETCONNECT_PROJECT_ID=

# =============================================================================
# Flare / Coston2 (chain 114) — the current build. Fill from the deploy outputs of
# packages/contracts/script/DeployFlareControlPlane.s.sol, and from
# fce-sigmax/config/extension.env for the instruction sender.
# =============================================================================
VITE_FLARE_TEE_VERIFIER=
VITE_FLARE_VAULT_FACTORY=
VITE_FLARE_SIGNAL_REGISTRY=
VITE_FLARE_SUBSCRIPTION_REGISTRY=
# The extension's on-chain entry point: publishSignal() commits the ciphertext hash
# and routes the ciphertext to the TEE as a SIGNAL/EXECUTE instruction.
VITE_FLARE_INSTRUCTION_SENDER=
# ext-proxy base URL — the browser fetches the enclave's ECIES public key from here
# to encrypt signals client-side. MUST be the same stable URL registered on-chain
# for the TEE machine (a rotating tunnel hostname strands the machine).
VITE_FLARE_PROXY_URL=
# Second route to the same proxy, tried whenever the first fails. In dev set
# VITE_FLARE_PROXY_URL=/enclave (the vite server proxies it — no CORS, no tunnel
# interstitial) and put the public tunnel URL here as the fallback.
VITE_FLARE_PROXY_FALLBACK=
# Extra Coston2 RPCs the app fails over across for every read (comma-separated).
VITE_FLARE_RPC_FALLBACKS=
# Optional overrides; sensible Coston2 defaults are compiled in.
VITE_FLARE_RPC_URL=
VITE_FXRP_ADDRESS=
VITE_FLARE_QUOTE_TOKEN=
VITE_BLAZESWAP_ROUTER=
VITE_FTSO_V2=
VITE_FLARE_FROM_BLOCK=33898193
